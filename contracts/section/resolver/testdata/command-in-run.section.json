{
  "id": "command-in-run",
  "title": "Commands",
  "summary": "A command variable in run",
  "variables": [
    {"name": "setup_command", "type": "command", "description": "Installs dependencies"},
    {"name": "test_command", "type": "command", "description": "Runs the tests"},
    {"name": "one_word", "type": "command", "description": "A command of one word"},
    {"name": "sentence", "description": "Text with a space"},
    {"name": "repo_dir", "description": "Directory of the clone"},
    {"name": "contacts", "type": "string", "description": "Who can help"}
  ],
  "steps": [
    {"id": "splice", "name": "Splice", "run": ["env", "$setup_command", "--", "$test_command", "$one_word"]},
    {"id": "string", "name": "String", "run": ["echo", "$sentence"]},
    {"id": "embedded", "name": "Embedded", "run": ["sh", "-c", "$setup_command && $test_command"]},
    {"id": "joined", "name": "Joined", "run": ["--dir=$repo_dir", "$repo_dir"]},
    {"id": "people", "name": "People", "run": ["notify", "$contacts"]},
    {"id": "check", "name": "Check", "checks": [{"run": ["time", "$test_command", "-v"]}]}
  ]
}
