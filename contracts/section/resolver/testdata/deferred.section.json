{
  "id": "deferred",
  "title": "Deferred",
  "summary": "Answers put off until later",
  "body": "a=[$value_a] b=[$value_b] d=[$value_d] e=[$value_e]",
  "variables": [
    {"name": "value_a", "description": "Deferred, with a default", "default": "A-default"},
    {"name": "value_b", "description": "Deferred, no default"},
    {"name": "value_c", "type": "command", "description": "A deferred command"},
    {"name": "value_d", "description": "Unanswered, default is deferred", "default": {"deferred": true}},
    {"name": "value_e", "description": "The word as text"},
    {"name": "value_f", "description": "Deferred in an environment value and a question"}
  ],
  "steps": [
    {
      "id": "run",
      "name": "Run",
      "run": ["make", "$value_c"],
      "env": {"VALUE": "x=$value_f"},
      "checks": [{"ask": "Is $value_f ready?"}]
    }
  ]
}
