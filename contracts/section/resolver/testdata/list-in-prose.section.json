{
  "id": "list-in-prose",
  "title": "Run $test_command",
  "summary": "Lists in sentences",
  "owner": "$solo",
  "verification": "$test_command passes.",
  "body": "Run $test_command. Lint with $lint_command. Or ask $solo.",
  "variables": [
    {"name": "test_command", "type": "command", "description": "Runs the tests"},
    {"name": "lint_command", "type": "command", "description": "Runs the linter"},
    {"name": "solo", "description": "One person"}
  ],
  "steps": [
    {
      "id": "test",
      "name": "Test",
      "notes": "Command: $test_command",
      "env": {"COMMAND": "$test_command"}
    }
  ]
}
