{
  "id": "list-in-prose",
  "title": "Run $test_command",
  "summary": "Lists in sentences",
  "owner": "$solo",
  "verification": "$test_command passes.",
  "body": "Run $test_command. Ask $contacts. Or ask $solo.",
  "variables": [
    {"name": "test_command", "type": "command", "description": "Runs the tests"},
    {"name": "contacts", "type": "person", "multiple": true, "description": "Who can help"},
    {"name": "solo", "type": "person", "multiple": true, "description": "One person"}
  ],
  "steps": [
    {
      "id": "test",
      "name": "Test",
      "notes": "Command: $test_command",
      "env": {"COMMAND": "$test_command"}
    }
  ]
}
