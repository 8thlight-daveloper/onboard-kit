  "sections": [
    {
      "id": "access",
      "title": "Access",
      "summary": "Request the accounts and permissions you need, and record who grants each.",
      "timing": "before-day-one",
      "owner": "$onboarding_owner_role",
      "verification": "You can open the repository, the CI dashboard, and the work tracker.",
      "body": "Request each system on day minus five if you can. Record who grants it and when\nyou asked.\n",
      "variables": [
        {
          "name": "onboarding_owner_role",
          "description": "Which role owns onboarding here? It appears as the owner of the Access section.",
          "type": "role",
          "required": true,
          "default": "engineering-manager"
        },
        {
          "name": "access_request_url",
          "description": "Where do people request source control access?",
          "example": "https://access.example.test/request",
          "required": true
        },
        {
          "name": "repo_url",
          "description": "What is the clone URL of the main repository?",
          "example": "git@git.example.test:team/service.git",
          "pattern": "^(git@|https://)\\S+$",
          "patternHint": "A clone URL, starting with git@ or https://",
          "required": true
        },
        {
          "name": "source_control_grantor",
          "description": "Which role grants source control access?",
          "type": "role",
          "required": true,
          "askIf": {
            "all": [
              {
                "question": "repo_url",
                "answer": {
                  "isSettled": true
                }
              }
            ]
          }
        },
        {
          "name": "ci_grantor",
          "description": "Which role grants CI dashboard access?",
          "type": "role",
          "required": true
        },
        {
          "name": "tracker_grantor",
          "description": "Which role grants work tracker access?",
          "type": "role",
          "required": true
        },
        {
          "name": "account_name",
          "description": "What is your account name at the organization?",
          "example": "arivera",
          "audience": "onboardee"
        }
      ],
      "steps": [
        {
          "id": "source-control",
          "name": "Source control",
          "owner": "$source_control_grantor",
          "open": "$access_request_url",
          "checks": [
            {
              "run": [
                "git",
                "ls-remote",
                "$repo_url"
              ]
            }
          ]
        },
        {
          "id": "ci-dashboard",
          "name": "CI dashboard",
          "notes": "Sign in as $account_name.",
          "owner": "$ci_grantor",
          "checks": [
            {
              "ask": "Can you open the CI dashboard?"
            }
          ]
        },
        {
          "id": "work-tracker",
          "name": "Work tracker",
          "owner": "$tracker_grantor",
          "checks": [
            {
              "ask": "Can you open the work tracker?"
            }
          ]
        }
      ],
      "source": {
        "template": "access",
        "hash": "7d29acbae0bc0dfd7d9a7c4692a757fded62e6dace674b36ddf09d8e5c413d62"
      }
    },
    {
      "id": "clone-and-run-tests",
      "title": "Clone the project and run the tests",
      "summary": "Get a working copy of the project and a passing test run on your machine.",
      "includeIf": {
        "all": [
          {
            "question": "plan.discipline",
            "answer": {
              "is": "software"
            }
          }
        ]
      },
      "timing": "week-one",
      "owner": "newcomer",
      "verification": "$test_command passes on a fresh clone.",
      "body": "If a test fails on a fresh clone, write down the failure and ask the team before\nchanging anything.\n",
      "variables": [
        {
          "name": "repo_url",
          "description": "What is the clone URL of the main repository?",
          "example": "git@git.example.test:team/service.git",
          "pattern": "^(git@|https://)\\S+$",
          "patternHint": "A clone URL, starting with git@ or https://",
          "required": true
        },
        {
          "name": "repo_dir",
          "description": "What should the clone's folder be called?",
          "example": "service",
          "default": "project"
        },
        {
          "name": "setup_command",
          "description": "Which command installs the dependencies?",
          "example": "make setup",
          "type": "command",
          "required": true
        },
        {
          "name": "test_command",
          "description": "Which command runs the test suite?",
          "example": "make test",
          "type": "command",
          "required": true
        }
      ],
      "steps": [
        {
          "id": "clone",
          "name": "Clone the repository",
          "run": [
            "git",
            "clone",
            "$repo_url",
            "$repo_dir"
          ],
          "checks": [
            {
              "run": [
                "test",
                "-d",
                "$repo_dir/.git"
              ]
            }
          ]
        },
        {
          "id": "install",
          "name": "Install dependencies",
          "run": [
            "$setup_command"
          ],
          "directory": "$repo_dir"
        },
        {
          "id": "run-tests",
          "name": "Run the tests",
          "run": [
            "$test_command"
          ],
          "directory": "$repo_dir"
        }
      ],
      "source": {
        "template": "clone-and-run-tests",
        "hash": "c41d0df0aad1fe56eeaa2a0cc2d17a19ba3bc92b022a41342a0e37482d8195a6"
      }
    },
    {
      "id": "review-design-system",
      "title": "Review the design system",
      "summary": "Find the design system and the main design file, and note what you cannot open.",
      "includeIf": {
        "all": [
          {
            "question": "plan.discipline",
            "answer": {
              "is": "design"
            }
          }
        ]
      },
      "timing": "week-one",
      "owner": "newcomer",
      "verification": "You can open the design system and the main design file.",
      "body": "Look at the design system before you start work. Write down anything that is\nmissing or out of date, and tell the team.\n",
      "variables": [
        {
          "name": "design_system_url",
          "description": "Where does the design system live?",
          "example": "https://design.example.test/system",
          "required": true
        },
        {
          "name": "design_file_url",
          "description": "Which is the main design file for the product?",
          "example": "https://design.example.test/files/main",
          "required": true
        }
      ],
      "steps": [
        {
          "id": "design-system",
          "name": "Open the design system",
          "open": "$design_system_url",
          "checks": [
            {
              "ask": "Can you open the design system?"
            }
          ]
        },
        {
          "id": "main-file",
          "name": "Open the main design file",
          "open": "$design_file_url",
          "checks": [
            {
              "ask": "Can you open the main design file?"
            }
          ]
        }
      ],
      "source": {
