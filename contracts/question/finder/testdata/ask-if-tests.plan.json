      {"name": "q_flag_true", "description": "Flag is true", "askIf": {"all": [{"question": "plan.uses_ci", "answer": {"is": true}}]}},
      {"name": "q_flag_false", "description": "Flag is false", "askIf": {"all": [{"question": "plan.uses_ci", "answer": {"is": false}}]}},
      {"name": "q_unanswered_is", "description": "Unanswered, is", "askIf": {"all": [{"question": "grantor", "answer": {"is": "x"}}]}},
      {"name": "q_unanswered_is_not", "description": "Unanswered, isNot", "askIf": {"all": [{"question": "grantor", "answer": {"isNot": "x"}}]}},
