      {"name": "q_deferred_is_not", "description": "Deferred, isNot", "askIf": {"all": [{"question": "later", "answer": {"isNot": "x"}}]}},
      {"name": "q_default_only", "description": "Default is not an answer", "askIf": {"all": [{"question": "tier", "answer": {"is": "gold"}}]}},
